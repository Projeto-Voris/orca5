    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov2</namespace>
      <joint_name>thruster5_joint</joint_name>
      <thrust_coefficient>@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov2</namespace>
      <joint_name>thruster6_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>
    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov2</namespace>
      <joint_name>thruster7_joint</joint_name>
      <!-- Reverse spin to balance torque -->
      <thrust_coefficient>-@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>
    <plugin
        filename="gz-sim-thruster-system"
        name="gz::sim::systems::Thruster">
      <namespace>bluerov2</namespace>
      <joint_name>thruster8_joint</joint_name>
      <thrust_coefficient>@thrust_coefficient</thrust_coefficient>
      <fluid_density>@fluid_density</fluid_density>
      <propeller_diameter>@propeller_diameter</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>@use_angvel_cmd</use_angvel_cmd>
    </plugin>

    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <!-- Port settings -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Transform from the Gazebo body frame (x-forward, y-left, z-up)
           to the ArduPilot body frame (x-forward, y-right, z-down) -->
      <modelXYZToAirplaneXForwardZDown>0 0 0 @d180 0 0</modelXYZToAirplaneXForwardZDown>

      <!-- Transform from the Gazebo world frame (ENU)
           to the ArduPilot world frame (NED) -->
      <gazeboXYZToNED>0 0 0 @d180 0 @d90</gazeboXYZToNED>

      <!-- Sensors -->
      <imuName>imu_sensor</imuName>

      <!-- Thrusters -->
      <control channel="0">
        <jointName>thruster1_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster1_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>
      <control channel="1">
        <jointName>thruster2_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster2_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>
      <control channel="2">
        <jointName>thruster3_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster3_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="3">
        <jointName>thruster4_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster4_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="4">
        <jointName>thruster5_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster5_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>
      <control channel="5">
        <jointName>thruster6_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster6_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="6">
        <jointName>thruster7_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster7_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@cw_control_multiplier</multiplier>
      </control>
      <control channel="7">
        <jointName>thruster8_joint</jointName>
        <servo_min>@servo_min</servo_min>
        <servo_max>@servo_max</servo_max>
        <type>COMMAND</type>
        <cmd_topic>@thruster8_topic</cmd_topic>
        <offset>@control_offset</offset>
        <multiplier>@ccw_control_multiplier</multiplier>
      </control>

     <!--
        Configure ArduSub to use a SITL rangefinder backend:
        param set RNGFND1_TYPE 100        # Type = SITL
        param set RNGFND1_FUNCTION 0      # Function = LINEAR
        param set RNGFND1_MIN_CM 20       # Min distance is 0.5m
        param set RNGFND1_MAX_CM 5000     # Max distance is 50m
        param set RNGFND1_ORIENT 25       # Down
        param set RNGFND1_POS_X @sonar_x
        param set RNGFND1_POS_Y @sonar_y
        param set RNGFND1_POS_Z @sonar_z
      -->
      <!-- <sensor>
        <type>sonar</type>
        <index>1</index>
        <topic>sonar_link/sensor/sonar</topic>
      </sensor> -->

    </plugin>

    <!-- Left Camera link -->
    <link name="passive_stereo_link">
      <pose>@passive_cam_x @passive_cam_y @passive_cam_z 0 0 0</pose>
        <sensor name="left_camera" type="camera">
          <pose>0 @p_cam_baseline 0 0 0 0 </pose>
          <camera>
            <horizontal_fov>@p_cam_fov</horizontal_fov>
            <image>
              <width>@p_img_width</width>
              <height>@p_img_height</height>
              <format>B8G8R8</format>
            </image>
            <distortion>
              <k1>0.0</k1>
              <k2>0.0</k2>
              <k3>0.0</k3>
              <p1>0.0</p1>
              <p2>0.0</p2>
              <center>0.5 0.5</center>
            </distortion>
            <noise>
              <type>gaussian</type>
              <mean>@p_noise_mean</mean>
              <stddev>@p_noise_std</stddev>
            </noise>
            <clip>
              <near>0.2</near>
              <far>@p_cam_far_clip</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>25</update_rate>
          <visualize>true</visualize>
          <topic>Passive/left/image_raw</topic>
          <gz_frame_id>Passive/left_camera_link</gz_frame_id>
        </sensor>
        <sensor name="right_camera" type="camera">
          <pose>0 -@p_cam_baseline 0 0 0 0 </pose>
          <camera>
            <horizontal_fov>@p_cam_fov</horizontal_fov>
            <image>
              <width>@p_img_width</width>
              <height>@p_img_height</height>
              <format>B8G8R8</format>
            </image>
            <distortion>
              <k1>0.0</k1>
              <k2>0.0</k2>
              <k3>0.0</k3>
              <p1>0.0</p1>
              <p2>0.0</p2>
              <center>0.5 0.5</center>
            </distortion>
            <noise>
              <type>gaussian</type>
              <mean>@p_noise_mean</mean>
              <stddev>@p_noise_std</stddev>
            </noise>
            <clip>
              <near>0.2</near>
              <far>@p_cam_far_clip</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>25</update_rate>
          <visualize>true</visualize>
          <topic>Passive/right/image_raw</topic>
          <gz_frame_id>Passive/right_camera_link</gz_frame_id>
        </sensor>
        <inertial>
          <mass>@passive_cam_mass</mass>
          <inertia>
            <ixx>@passive_cam_ixx</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>@passive_cam_iyy</iyy>
            <iyz>0</iyz>
            <izz>@passive_cam_izz</izz>
          </inertia>
        </inertial>
      </link>

    <!-- Attach camera_link to base_link -->
    <joint name="stereo_p_joint" type="fixed">
      <parent>base_link</parent>
      <child>passive_stereo_link</child>
    </joint>

    <link name='sonar_link'>
      <pose>@sonar_x @sonar_y @sonar_z 0 0 0</pose>
      <inertial>
        <mass>@sonar_mass</mass>
        <inertia>
          <ixx>@sonar_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@sonar_iyy</iyy>
          <iyz>0</iyz>
          <izz>@sonar_izz</izz>
        </inertia>
      </inertial>
      <!-- Use a gpu_lidar sensor to emulate a Ping sonar sensor. The sensor is configured to generate 5x5=25 range
           values in a pretty tight square. (The beam angle is 17 degrees in x or y, or 24 degrees diagonally.)
           ardupilot_gazebo will pick the minimum value and send it as a rangefinder reading. -->
      <sensor name="sonar_3d" type="gpu_lidar">
      <pose>0 0 0 -@d180 0 0</pose>
      <topic>sonar_3d</topic>
      <update_rate>@sonar_hz</update_rate>
      <gz_frame_id>sonar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>@sonar_h_samples</samples> 
            <resolution>1</resolution>
            <min_angle>-@sonar_h_angle</min_angle> 
            <max_angle>@sonar_h_angle</max_angle>
          </horizontal>
          <vertical>
            <samples>@sonar_v_samples</samples>
            <resolution>1</resolution>
            <min_angle>-@sonar_v_angle</min_angle>
             <max_angle>@sonar_v_angle</max_angle>  
          </vertical>
        </scan>
        <range>
          <min>0.2</min>  
          <max>@sonar_max_range</max>   
          <resolution>@sonar_resolution</resolution> 
        </range>
         <noise>
            <type>gaussian</type>
            <mean>@sonar_noise_mean</mean>
            <stddev>@sonar_noise_std</stddev>
          </noise>
      </lidar>
    </sensor>
    </link>

    <joint name='sonar_joint' type='fixed'>
      <parent>base_link</parent>
      <child>sonar_link</child>
    </joint>


    <link name='dvl_link'>
      <pose>@dvl_x @dvl_y @dvl_z 0 0 0</pose>
      <inertial>
        <mass>@dvl_mass</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <visual name="dvl_visual">
        <geometry>
          <cylinder>
            <length>@dvl_height</length>
            <radius>@dvl_radius</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.0 0.0 1.0</ambient>
          <diffuse>0.2 0.0 0.0 1.0</diffuse>
        </material>
      </visual>
      <sensor name="A50" type="custom" gz:type="dvl">
          <pose degrees="true">0 0 0 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>/model/bluerov2/dvl/velocity</topic>
          <gz_frame_id>dvl_link</gz_frame_id>
          <gz:dvl>
            <type>phased_array</type>
            <arrangement degrees="true">
              <beam id="1">
                <aperture>2</aperture>
                <rotation>45</rotation>
                <tilt>22.5</tilt>
              </beam>
              <beam>
                <aperture>2</aperture>
                <rotation>135</rotation>
                <tilt>22.5</tilt>
              </beam>
              <beam>
                <aperture>2</aperture>
                <rotation>-45</rotation>
                <tilt>22.5</tilt>
              </beam>
              <beam>
                <aperture>2</aperture>
                <rotation>-135</rotation>
                <tilt>22.5</tilt>
              </beam>
            </arrangement>
            <tracking>
              <bottom_mode>
                <when>best</when>
                <noise type="gaussian">
                  <mean>@dvl_noise_mean</mean>
                  <stddev>@dvl_noise_std</stddev>
                </noise>
                <visualize>false</visualize>
              </bottom_mode>
            </tracking>
            <resolution>0.01</resolution>
            <maximum_range>@dvl_max_range</maximum_range>
            <minimum_range>0.1</minimum_range>
            <reference_frame>0 0 0 0 0 0</reference_frame>
          </gz:dvl>
        </sensor>      
    </link>

    <joint name='dvl_joint' type='fixed'>
      <parent>base_link </parent>
      <child>dvl_link</child>
    </joint>
    
    <!-- Publish the ground-truth pose for rviz -->
    <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>bluerov2</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
