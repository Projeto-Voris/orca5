        </geometry>
      </visual>
      <inertial>
        <mass>@propeller_mass</mass>
        <inertia>
          <ixx>@propeller_ixx</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>@propeller_iyy</iyy>
          <iyz>0</iyz>
          <izz>@propeller_izz</izz>
        </inertia>
      </inertial>
    </link>

    <link name="thruster4">
      <pose>-@thruster_h_x @thruster_h_y @thruster_h_z -@d90 @d90 @d135</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 @d90 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/t200-cw-prop.dae</uri>
