<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Same world name as inpetu_heavy.world: cfg/gzbridge_config.yaml and heavy_sim.launch.py bridge the IMU from
         /world/inpetu/... -->
    <world name="inpetu">

        <scene>
            <!-- For turquoise ambient to match particle effect -->
            <ambient>0.0 1.0 1.0</ambient>
            <background>0.0 0.7 0.8</background>
        </scene>

        <physics name="1ms" type="ode">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <!-- Base Gazebo plugins -->
        <plugin
                filename="gz-sim-physics-system"
                name="gz::sim::systems::Physics">
        </plugin>
        <plugin
                filename="gz-sim-user-commands-system"
                name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin
                filename="gz-sim-scene-broadcaster-system"
                name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <plugin
                filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
            <!--      <render_engine>ogre</render_engine>-->
        </plugin>
        
        <!-- DVL Plugin -->
         <plugin
            filename="gz-sim-dvl-system"
            name="gz::sim::systems::DopplerVelocityLogSystem">
        </plugin>

        <!-- IMU plugin manages all IMU sensors -->
        <plugin
                filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu">
        </plugin>

        <!-- Buoyancy plugin manages buoyancy for all models -->
        <plugin
                filename="gz-sim-buoyancy-system"
                name="gz::sim::systems::Buoyancy">
            <!-- Fluid density is 1 (air) above 0 and 1000 (water) below 0 -->
            <graded_buoyancy>
                <default_density>1000</default_density>
                <density_change>
                    <above_depth>0</above_depth>
                    <density>1</density>
                </density_change>
            </graded_buoyancy>
            <!-- Enable by model name -->
            <enable>bluerov2</enable>
        </plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>2 1.3 5 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>0 0 -9</direction>
        </light>

        <!-- Sun straight down does not light the walls of the corridor or the fronts of the landmarks: two
             fill lights, one towards +x+y and one towards -x-y, light every face the camera sees going and coming back -->
        <light type="directional" name="fill_forward">
            <cast_shadows>false</cast_shadows>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <direction>0.5 0.5 -1</direction>
        </light>

        <light type="directional" name="fill_backward">
            <cast_shadows>false</cast_shadows>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <direction>-0.5 -0.5 -1</direction>
        </light>

        <include>
            <uri>model://bluerov2</uri>
            <pose>0 0 -1 0 0 0</pose>
        </include>

        <!-- Corridor of 36 x 3 m, floor at z = -4.5 (generated by scripts/generate_corridor.py).
             Its start wall is 2 m behind the ROV and it runs along +x up to x = 34 -->
        <include>
            <uri>model://corredor</uri>
            <pose>-2 0 0 0 0 0</pose>
        </include>
    </world>
</sdf>
